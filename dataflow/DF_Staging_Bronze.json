			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          id_producto as string,",
				"          nombre_producto as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> srcStagingProductos",
				"source(output(",
				"          address as (city as string, geo as (lat as double, lng as double), street as string, suite as string, zipcode as string),",
				"          company as (bs as string, catchPhrase as string, name as string),",
				"          email as string,",
				"          id as short,",
				"          name as string,",
				"          phone as string,",
				"          username as string,",
				"          website as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> srcStagingClientes",
				"source(output(",
				"          id_pedido as integer,",
				"          id_cliente as integer,",
				"          fecha as date,",
				"          fecha_modificacion_utc as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcStagingPedidos",
				"source(output(",
				"          id_detalle as integer,",
				"          id_pedido as integer,",
				"          id_producto as integer,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(10,2),",
				"          fecha_modificacion_utc as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcStagingDetallePedido",
				"srcStagingProductos sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/producto',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> snkBronzeProductos",
				"srcStagingClientes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/cliente',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> snkBronzeClientes",
				"srcStagingPedidos sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/pedido',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> snkBronzePedidos",
				"srcStagingDetallePedido sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/pedido/detalle_pedido',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> snkBronzeDetallePedido"
			]
		}
	}
}