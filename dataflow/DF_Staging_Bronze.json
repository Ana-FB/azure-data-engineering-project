{
	"name": "DF_Staging_Bronze_copy1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Staging_Productos_CSV",
						"type": "DatasetReference"
					},
					"name": "srcStagingProductos"
				},
				{
					"dataset": {
						"referenceName": "DS_ADLS_Staging_Clientes_JSON",
						"type": "DatasetReference"
					},
					"name": "srcStagingClientes"
				},
				{
					"dataset": {
						"referenceName": "DS_ADLS_Staging_SQL_Parquet",
						"type": "DatasetReference"
					},
					"name": "srcStagingPedidos"
				},
				{
					"dataset": {
						"referenceName": "DS_ADLS_Staging_SQL_Parquet",
						"type": "DatasetReference"
					},
					"name": "srcStagingDetallePedido"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					},
					"name": "snkBronzeProductos",
					"rejectedDataLinkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					},
					"name": "snkBronzeClientes",
					"rejectedDataLinkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					},
					"name": "snkBronzePedidos",
					"rejectedDataLinkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					},
					"name": "snkBronzeDetallePedido",
					"rejectedDataLinkedService": {
						"referenceName": "LS_ADLS_Gen2",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "drvIngestaProductos"
				},
				{
					"name": "drvIngestaClientes"
				},
				{
					"name": "drvIngestaPedidos"
				},
				{
					"name": "drvIngestaDetallePedido"
				}
			],
			"scriptLines": [
				"parameters{",
				"     p_id_lote as string",
				"}",
				"source(output(",
				"          id_producto as string,",
				"          nombre_producto as string,",
				"          categoria as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> srcStagingProductos",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> srcStagingClientes",
				"source(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> srcStagingPedidos",
				"source(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> srcStagingDetallePedido",
				"srcStagingProductos derive(fecha_ingesta = currentDate('America/Argentina/Buenos_Aires'),",
				"          id_lote = $p_id_lote) ~> drvIngestaProductos",
				"srcStagingClientes derive(fecha_ingesta = currentDate('America/Argentina/Buenos_Aires'),",
				"          id_lote = $p_id_lote) ~> drvIngestaClientes",
				"srcStagingPedidos derive(fecha_ingesta = currentDate('America/Argentina/Buenos_Aires'),",
				"          id_lote = $p_id_lote) ~> drvIngestaPedidos",
				"srcStagingDetallePedido derive(fecha_ingesta = currentDate('America/Argentina/Buenos_Aires'),",
				"          id_lote = $p_id_lote) ~> drvIngestaDetallePedido",
				"drvIngestaProductos sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/producto',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('key',",
				"          0,",
				"          fecha_ingesta",
				"     )) ~> snkBronzeProductos",
				"drvIngestaClientes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/cliente',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     partitionBy('key',",
				"          0,",
				"          fecha_ingesta",
				"     )) ~> snkBronzeClientes",
				"drvIngestaPedidos sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/pedido',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 3,",
				"     partitionBy('key',",
				"          0,",
				"          fecha_ingesta",
				"     )) ~> snkBronzePedidos",
				"drvIngestaDetallePedido sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'delta',",
				"     fileSystem: 'datos',",
				"     folderPath: 'bronze/pedido/detalle_pedido',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 4,",
				"     partitionBy('key',",
				"          0,",
				"          fecha_ingesta",
				"     )) ~> snkBronzeDetallePedido"
			]
		}
	}
}