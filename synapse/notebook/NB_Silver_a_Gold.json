		"cells": [
			{
				"cell_type": "code",
				"source": [
					"base_silver = \"abfss://datos@proyectos2027.dfs.core.windows.net/silver\"\n",
					"base_gold = \"abfss://datos@proyectos2027.dfs.core.windows.net/gold\"\n",
					"\n",
					"# Tablas Silver\n",
					"ruta_cliente = f\"{base_silver}/cliente\"\n",
					"ruta_ubicacion = f\"{base_silver}/ubicacion\"\n",
					"ruta_producto = f\"{base_silver}/producto\"\n",
					"ruta_pedidos = f\"{base_silver}/pedidos\"\n",
					"ruta_detalle_pedido = f\"{base_silver}/detalle_pedido\"\n",
					"\n",
					"# Tablas Gold\n",
					"ruta_dim_cliente = f\"{base_gold}/dim_cliente\"\n",
					"ruta_dim_ubicacion = f\"{base_gold}/dim_ubicacion\"\n",
					"ruta_dim_producto = f\"{base_gold}/dim_producto\"\n",
					"ruta_dim_fecha = f\"{base_gold}/dim_fecha\"\n",
					"ruta_fact_ventas = f\"{base_gold}/fact_ventas\"\n",
					"\n",
					"print(\"Rutas configuradas para Silver → Gold\")"
				],
				"execution_count": 2
			},
			{
				"cell_type": "code",
				"source": [
					"rutas_silver = {\n",
					"    \"clientes\": ruta_cliente,\n",
					"    \"ubicaciones\": ruta_ubicacion,\n",
					"    \"productos\": ruta_producto,\n",
					"    \"pedidos\": ruta_pedidos,\n",
					"    \"detalle_pedido\": ruta_detalle_pedido\n",
					"}\n",
					"\n",
					"# Verificar que las cinco tablas Delta existan\n",
					"tablas_faltantes = [\n",
					"    nombre\n",
					"    for nombre, ruta in rutas_silver.items()\n",
					"    if not mssparkutils.fs.exists(f\"{ruta}/_delta_log\")\n",
					"]\n",
					"\n",
					"if tablas_faltantes:\n",
					"    raise Exception(\n",
					"        f\"No encuentro estas tablas Silver: {tablas_faltantes}. \"\n",
					"        \"Revisá que estén creadas antes de continuar.\"\n",
					"    )\n",
					"\n",
					"# Leer las tablas Silver\n",
					"df_cliente = spark.read.format(\"delta\").load(ruta_cliente)\n",
					"df_ubicacion = spark.read.format(\"delta\").load(ruta_ubicacion)\n",
					"df_producto = spark.read.format(\"delta\").load(ruta_producto)\n",
					"df_pedidos = spark.read.format(\"delta\").load(ruta_pedidos)\n",
					"df_detalle_pedido = spark.read.format(\"delta\").load(ruta_detalle_pedido)\n",
					"\n",
					"# Revisar las columnas y sus tipos de datos\n",
					"for nombre, df in [\n",
					"    (\"Clientes\", df_cliente),\n",
					"    (\"Ubicaciones\", df_ubicacion),\n",
					"    (\"Productos\", df_producto),\n",
					"    (\"Pedidos\", df_pedidos),\n",
					"    (\"Detalle de pedido\", df_detalle_pedido)\n",
					"]:\n",
					"    print(f\"\\n--- {nombre} ---\")\n",
					"    df.printSchema()"
				],
				"execution_count": 3
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"from pyspark.sql import functions as F\n",
					"from pyspark.sql.window import Window\n",
					"\n",
					"# Una clave técnica ordenada para cada cliente\n",
					"ventana_clientes_gold = Window.orderBy(\"id_cliente\")\n",
					"\n",
					"dim_cliente_real = (\n",
					"    df_cliente\n",
					"    .filter(F.col(\"id_cliente\").isNotNull())\n",
					"    .dropDuplicates([\"id_cliente\"])\n",
					"    .withColumn(\n",
					"        \"cliente_key\",\n",
					"        F.row_number().over(ventana_clientes_gold).cast(\"long\")\n",
					"    )\n",
					"    .select(\n",
					"        \"cliente_key\",\n",
					"        F.col(\"id_cliente\").cast(\"int\").alias(\"id_cliente\"),\n",
					"        \"nombre\",\n",
					"        \"sobrenombre\",\n",
					"        \"email\",\n",
					"        \"telefono\"\n",
					"    )\n",
					")\n",
					"\n",
					"# Fila especial para pedidos cuyo cliente no aparece en Silver\n",
					"cliente_desconocido = spark.createDataFrame(\n",
					"    [(0, -1, \"Desconocido\", \"Desconocido\", \"***\", \"***\")],\n",
					"    schema=\"\"\"\n",
					"        cliente_key BIGINT,\n",
					"        id_cliente INT,\n",
					"        nombre STRING,\n",
					"        sobrenombre STRING,\n",
					"        email STRING,\n",
					"        telefono STRING\n",
					"    \"\"\"\n",
					")\n",
					"\n",
					"dim_cliente = (\n",
					"    dim_cliente_real\n",
					"    .unionByName(cliente_desconocido)\n",
					"    .orderBy(\"cliente_key\")\n",
					")\n",
					"\n",
					"display(dim_cliente)\n",
					"print(\"Clientes en dim_cliente, incluido el desconocido:\", dim_cliente.count())"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"ventana_ubicaciones_gold = Window.orderBy(\"id_ubicacion\")\n",
					"\n",
					"dim_ubicacion_real = (\n",
					"    df_ubicacion\n",
					"    .filter(F.col(\"id_ubicacion\").isNotNull())\n",
					"    .dropDuplicates([\"id_ubicacion\"])\n",
					"    .withColumn(\n",
					"        \"ubicacion_key\",\n",
					"        F.row_number().over(ventana_ubicaciones_gold).cast(\"long\")\n",
					"    )\n",
					"    .select(\n",
					"        \"ubicacion_key\",\n",
					"        \"id_ubicacion\",\n",
					"        \"ciudad\",\n",
					"        \"latitud\",\n",
					"        \"longitud\"\n",
					"    )\n",
					")\n",
					"\n",
					"ubicacion_desconocida = spark.createDataFrame(\n",
					"    [(0, \"-1\", \"Desconocida\", None, None)],\n",
					"    schema=\"\"\"\n",
					"        ubicacion_key BIGINT,\n",
					"        id_ubicacion STRING,\n",
					"        ciudad STRING,\n",
					"        latitud DECIMAL(10,6),\n",
					"        longitud DECIMAL(10,6)\n",
					"    \"\"\"\n",
					")\n",
					"\n",
					"dim_ubicacion = (\n",
					"    dim_ubicacion_real\n",
					"    .unionByName(ubicacion_desconocida)\n",
					"    .orderBy(\"ubicacion_key\")\n",
					")\n",
					"\n",
					"display(dim_ubicacion)\n",
					"print(\"Ubicaciones en dim_ubicacion, incluida la desconocida:\", dim_ubicacion.count())"
				],
				"execution_count": 5
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"ventana_productos_gold = Window.orderBy(\"id_producto\")\n",
					"\n",
					"dim_producto_real = (\n",
					"    df_producto\n",
					"    .filter(F.col(\"id_producto\").isNotNull())\n",
					"    .dropDuplicates([\"id_producto\"])\n",
					"    .withColumn(\n",
					"        \"producto_key\",\n",
					"        F.row_number().over(ventana_productos_gold).cast(\"long\")\n",
					"    )\n",
					"    .select(\n",
					"        \"producto_key\",\n",
					"        F.col(\"id_producto\").cast(\"int\").alias(\"id_producto\"),\n",
					"        \"nombre_producto\",\n",
					"        \"categoria\"\n",
					"    )\n",
					")\n",
					"\n",
					"producto_desconocido = spark.createDataFrame(\n",
					"    [(0, -1, \"Desconocido\", \"Desconocida\")],\n",
					"    schema=\"\"\"\n",
					"        producto_key BIGINT,\n",
					"        id_producto INT,\n",
					"        nombre_producto STRING,\n",
					"        categoria STRING\n",
					"    \"\"\"\n",
					")\n",
					"\n",
					"dim_producto = (\n",
					"    dim_producto_real\n",
					"    .unionByName(producto_desconocido)\n",
					"    .orderBy(\"producto_key\")\n",
					")\n",
					"\n",
					"display(dim_producto)\n",
					"print(\"Productos en dim_producto, incluido el desconocido:\", dim_producto.count())"
				],
				"execution_count": 6
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"# Obtener el rango de fechas de los pedidos\n",
					"rango_fechas = df_pedidos.agg(\n",
					"    F.min(F.to_date(\"fecha\")).alias(\"fecha_minima\"),\n",
					"    F.max(F.to_date(\"fecha\")).alias(\"fecha_maxima\")\n",
					").first()\n",
					"\n",
					"if rango_fechas[\"fecha_minima\"] is None:\n",
					"    raise Exception(\"No hay fechas válidas en la tabla de pedidos.\")\n",
					"\n",
					"# Crear una fila por cada día del rango\n",
					"calendario = spark.range(1).select(\n",
					"    F.explode(\n",
					"        F.sequence(\n",
					"            F.lit(rango_fechas[\"fecha_minima\"]),\n",
					"            F.lit(rango_fechas[\"fecha_maxima\"]),\n",
					"            F.expr(\"INTERVAL 1 DAY\")\n",
					"        )\n",
					"    ).alias(\"fecha\")\n",
					")\n",
					"\n",
					"dim_fecha_real = calendario.select(\n",
					"    F.date_format(\"fecha\", \"yyyyMMdd\").cast(\"int\").alias(\"fecha_key\"),\n",
					"    F.col(\"fecha\").cast(\"date\").alias(\"fecha\"),\n",
					"    F.dayofmonth(\"fecha\").alias(\"dia\"),\n",
					"    F.month(\"fecha\").alias(\"mes\"),\n",
					"    F.quarter(\"fecha\").alias(\"trimestre\"),\n",
					"    F.year(\"fecha\").alias(\"anio\")\n",
					")\n",
					"\n",
					"# Clave 0 para fechas nulas o que no se encuentren en el calendario\n",
					"fecha_desconocida = spark.createDataFrame(\n",
					"    [(0, None, None, None, None, None)],\n",
					"    schema=\"\"\"\n",
					"        fecha_key INT,\n",
					"        fecha DATE,\n",
					"        dia INT,\n",
					"        mes INT,\n",
					"        trimestre INT,\n",
					"        anio INT\n",
					"    \"\"\"\n",
					")\n",
					"\n",
					"dim_fecha = (\n",
					"    dim_fecha_real\n",
					"    .unionByName(fecha_desconocida)\n",
					"    .orderBy(\"fecha_key\")\n",
					")\n",
					"\n",
					"display(dim_fecha)\n",
					"print(\"Fechas en dim_fecha, incluida la desconocida:\", dim_fecha.count())"
				],
				"execution_count": 7
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"# Separar las líneas con precio negativo o nulo para no incorporarlas\n",
					"# a la tabla de hechos hasta revisarlas.\n",
					"lineas_precio_invalido = df_detalle_pedido.filter(\n",
					"    F.col(\"precio_unitario\").isNull()\n",
					"    | (F.col(\"precio_unitario\") < 0)\n",
					")\n",
					"\n",
					"detalle_valido = df_detalle_pedido.filter(\n",
					"    F.col(\"precio_unitario\").isNotNull()\n",
					"    & (F.col(\"precio_unitario\") >= 0)\n",
					")\n",
					"\n",
					"# Unir cada línea con su pedido y con las dimensiones Gold\n",
					"fact_ventas = (\n",
					"    detalle_valido.alias(\"det\")\n",
					"    .join(\n",
					"        df_pedidos.alias(\"ped\"),\n",
					"        F.col(\"det.id_pedido\") == F.col(\"ped.id_pedido\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .join(\n",
					"        df_cliente.alias(\"cli\"),\n",
					"        F.col(\"ped.id_cliente\") == F.col(\"cli.id_cliente\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .join(\n",
					"        dim_cliente.alias(\"dc\"),\n",
					"        F.col(\"cli.id_cliente\") == F.col(\"dc.id_cliente\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .join(\n",
					"        dim_ubicacion.alias(\"du\"),\n",
					"        F.col(\"cli.id_ubicacion\") == F.col(\"du.id_ubicacion\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .join(\n",
					"        dim_producto.alias(\"dp\"),\n",
					"        F.col(\"det.id_producto\") == F.col(\"dp.id_producto\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .join(\n",
					"        dim_fecha.alias(\"df\"),\n",
					"        F.to_date(F.col(\"ped.fecha\")) == F.col(\"df.fecha\"),\n",
					"        \"left\"\n",
					"    )\n",
					"    .select(\n",
					"        F.coalesce(F.col(\"dc.cliente_key\"), F.lit(0))\n",
					"            .cast(\"long\").alias(\"cliente_key\"),\n",
					"        F.coalesce(F.col(\"du.ubicacion_key\"), F.lit(0))\n",
					"            .cast(\"long\").alias(\"ubicacion_key\"),\n",
					"        F.coalesce(F.col(\"dp.producto_key\"), F.lit(0))\n",
					"            .cast(\"long\").alias(\"producto_key\"),\n",
					"        F.coalesce(F.col(\"df.fecha_key\"), F.lit(0))\n",
					"            .cast(\"int\").alias(\"fecha_key\"),\n",
					"        F.col(\"det.id_pedido\").cast(\"int\").alias(\"id_pedido\"),\n",
					"        F.col(\"det.id_detalle\").cast(\"int\").alias(\"id_detalle\"),\n",
					"        F.col(\"det.cantidad\").cast(\"int\").alias(\"cantidad\"),\n",
					"        F.col(\"det.precio_unitario\").cast(\"decimal(10,2)\")\n",
					"            .alias(\"precio_unitario\"),\n",
					"        (\n",
					"            F.col(\"det.cantidad\").cast(\"decimal(10,2)\")\n",
					"            * F.col(\"det.precio_unitario\").cast(\"decimal(10,2)\")\n",
					"        ).cast(\"decimal(12,2)\").alias(\"importe\")\n",
					"    )\n",
					")\n",
					"\n",
					"display(fact_ventas.orderBy(\"id_pedido\", \"id_detalle\"))\n",
					"\n",
					"print(\"Líneas válidas para Gold:\", fact_ventas.count())\n",
					"print(\"Líneas apartadas por precio negativo o nulo:\", lineas_precio_invalido.count())\n",
					"print(\n",
					"    \"Líneas con cliente desconocido:\",\n",
					"    fact_ventas.filter(F.col(\"cliente_key\") == 0).count()\n",
					")\n",
					"print(\n",
					"    \"Líneas con producto desconocido:\",\n",
					"    fact_ventas.filter(F.col(\"producto_key\") == 0).count()\n",
					")"
				],
				"execution_count": 8
			},
			{
				"cell_type": "code",
				"source": [
					"tablas_gold = [\n",
					"    (\"dim_cliente\", dim_cliente, ruta_dim_cliente),\n",
					"    (\"dim_ubicacion\", dim_ubicacion, ruta_dim_ubicacion),\n",
					"    (\"dim_producto\", dim_producto, ruta_dim_producto),\n",
					"    (\"dim_fecha\", dim_fecha, ruta_dim_fecha),\n",
					"    (\"fact_ventas\", fact_ventas, ruta_fact_ventas)\n",
					"]\n",
					"\n",
					"for nombre, df, ruta in tablas_gold:\n",
					"    (\n",
					"        df.write\n",
					"        .format(\"delta\")\n",
					"        .mode(\"overwrite\")\n",
					"        .option(\"overwriteSchema\", \"true\")\n",
					"        .save(ruta)\n",
					"    )\n",
					"    print(f\"{nombre} guardada en: {ruta}\")"
				],
				"execution_count": 9
			}
		]
	}
}