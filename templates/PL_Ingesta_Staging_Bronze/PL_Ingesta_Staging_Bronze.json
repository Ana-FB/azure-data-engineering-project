				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Staging_Productos_CSV",
								"type": "DatasetReference"
							},
							"name": "srcStagingProductos"
						},
						{
							"dataset": {
								"referenceName": "DS_ADLS_Staging_Clientes_JSON",
								"type": "DatasetReference"
							},
