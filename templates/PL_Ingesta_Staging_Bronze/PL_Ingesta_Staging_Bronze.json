							"activities": [
								{
									"name": "Script1",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "[parameters('LS_AzureSQL')]",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "NonQuery",
												"text": {
													"value": "@concat(\n    'UPDATE control.control_watermarks ',\n    'SET ultimo_watermark = CONVERT(datetime2(7), ''',\n    item().nuevo_watermark,\n    '''), ultima_ejecucion_exitosa_utc = SYSUTCDATETIME() ',\n    'WHERE nombre_fuente = ''',\n    item().nombre_fuente,\n    ''' AND ultimo_watermark <= CONVERT(datetime2(7), ''',\n    item().nuevo_watermark,\n    ''');'\n)",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
