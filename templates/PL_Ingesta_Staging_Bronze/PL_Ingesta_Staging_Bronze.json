								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "drvIngestaProductos"
						},
						{
							"name": "drvIngestaClientes"
						},
						{
							"name": "drvIngestaPedidos"
						},
						{
							"name": "drvIngestaDetallePedido"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_id_lote as string",
						"}",
						"source(output(",
						"          id_producto as string,",
						"          nombre_producto as string,",
						"          categoria as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     ignoreNoFilesFound: false) ~> srcStagingProductos",
						"source(output(",
						"          address as (city as string, geo as (lat as double, lng as double), street as string, suite as string, zipcode as string),",
						"          company as (bs as string, catchPhrase as string, name as string),",
						"          email as string,",
						"          id as short,",
						"          name as string,",
						"          phone as string,",
						"          username as string,",
						"          website as string",
						"     ),",
						"     allowSchemaDrift: true,",
