									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT COALESCE(MAX(',\n    item().columna_watermark,\n    '), CAST(''1900-01-01'' AS datetime2(7))) AS nuevo_watermark FROM ',\n    item().origen\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_SQL",
											"type": "DatasetReference"
										}
									}
								},
								{
									"name": "CP_SQL_Staging",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "LK_Limite_SQL",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT * FROM ',\n    item().origen,\n    ' WHERE ',\n    item().columna_watermark,\n    ' > ''',\n    item().ultimo_watermark,\n    ''' AND ',\n    item().columna_watermark,\n    ' <= ''',\n    activity('LK_Limite_SQL').output.firstRow.nuevo_watermark,\n    ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Staging_SQL_Parquet",
											"type": "DatasetReference",
											"parameters": {
												"p_carpeta": {
													"value": "@concat('staging/', item().id_fuente, '/', pipeline().RunId)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Append",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "CP_SQL_Staging",
											"dependencyConditions": [
