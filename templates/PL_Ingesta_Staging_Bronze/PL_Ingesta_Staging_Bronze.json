									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_watermarks_pendientes",
										"value": {
											"value": "@json(concat(\n    '{\"nombre_fuente\":\"',\n    item().id_fuente,\n    '\",\"nuevo_watermark\":\"',\n    activity('LK_Limite_SQL').output.firstRow.nuevo_watermark,\n    '\"}'\n))",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Delete1",
								"dependencyConditions": [
									"Succeeded"
								]
