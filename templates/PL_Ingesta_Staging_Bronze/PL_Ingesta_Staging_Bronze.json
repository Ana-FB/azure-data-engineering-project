						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    c.id_fuente,\n    c.origen,\n    c.columna_watermark,\n    c.ruta_bronze,\n    w.ultimo_watermark\nFROM control.config_ingesta AS c\nINNER JOIN control.control_watermarks AS w\n    ON w.nombre_fuente = c.id_fuente\nWHERE c.activo = 1\n  AND c.tipo_fuente = 'SQL'\n  AND c.estrategia = 'WATERMARK';",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL",
								"type": "DatasetReference"
							},
							"firstRowOnly": false
						}
					},
