{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "df-ana"
		},
		"ExcelDrive_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ExcelDrive\""
		},
		"LS_ADLS_Gen2_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"LS_ADLS_Gen2\""
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"LS_AzureSQL\""
		},
		"LS_storage_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"LS_storage\""
		},
		"ExcelDrive_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://drive.google.com/file/d/12Dirz5NkXa7QzIQOzp5wV8XFKMPqtuvp/view?usp=sharing"
		},
		"ExcelDrive_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "anaadmin"
		},
		"LS_ADLS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://proyectos2027.dfs.core.windows.net/"
		},
		"LS_API_Clientes_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-practica-ana.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "practica01"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "anaadmin"
		},
		"LS_Synapse_Artifacts_properties_typeProperties_endpoint": {
			"type": "string",
			"defaultValue": "https://synapse-ingenieria-demo-2026.dev.azuresynapse.net"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
